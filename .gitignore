# Miscellaneous
*.class
*.log
*.pyc
*.pyo
__pycache__/
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Android signing. These two are the app's identity: anyone holding them can
# publish an update that installs over yours. They never go in the repository —
# see README.md for how to set them up on a new machine.
key.properties
*.jks
*.keystore
*.p12

# Local Android SDK paths, machine-specific.
/android/local.properties

# Build output that sometimes lands outside /build.
*.apk
*.aab
*.aab.idsig
*.apks

# Save files exported by the app during testing.
*.bjsave

# Markdown is working notes by default; the README is the one that ships.
*.md
!README.md
